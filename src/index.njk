---
layout: base.njk
---
<div class="site-width">
  <header class="py-[4.25rem] pb-[3.75rem] max-sm:py-11">
    <p class="eyebrow mb-4">Notes on databases &amp; data systems</p>
    <h1 class="font-display text-display font-black text-heading">Bread Butter Bytes<span class="text-accent">.</span></h1>
    <p class="mt-5 max-w-2xl text-lead">Databases, explained from the inside out.</p>
  </header>
  <section class="pb-16" aria-labelledby="articles-heading">
    <div class="flex items-center justify-between gap-4 border-t-2 border-black py-4 pb-7">
      <h2 id="articles-heading" class="font-mono text-small font-bold">All articles</h2>
      <span class="font-mono text-small">{{ collections.articles | length }} entries</span>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-7">
      {% for article in collections.articles %}
      <article class="article-card">
        <a class="card-link" href="{{ article.url | url }}">
          <div class="card-image"><img src="{{ article.data.diagram | url }}" alt="" width="640" height="360"></div>
          <div class="card-body">
            <p class="eyebrow">{{ article.data.topic }}</p>
            <h3 class="font-display text-card font-black text-heading mt-4">{{ article.data.title }}</h3>
            <p class="mt-4 text-body">{{ article.data.description }}</p>
            <div class="card-meta font-mono text-small">
              <time datetime="{{ article.date | isoDate }}">{{ article.date | postDate }}</time>
              <span class="card-arrow" aria-hidden="true">&#8599;</span>
            </div>
          </div>
        </a>
      </article>
      {% endfor %}
    </div>
  </section>
</div>
